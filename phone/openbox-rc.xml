<?xml version="1.0" encoding="UTF-8"?>
<!-- Window settings for RuneLite on the phone: every window opens full screen with no title bar. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
	<applications>
		<application class="*">
			<decor>no</decor>
			<maximized>yes</maximized>
		</application>
	</applications>
</openbox_config>
